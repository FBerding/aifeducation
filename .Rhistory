prepare_session()
# Load data
example_data <- imdb_movie_reviews
example_data$label <- as.character(example_data$label)
example_data$label[c(76:100)] <- NA
example_data$label[c(201:250)] <- NA
data_set_reviews_text <- LargeDataSetForText$new()
data_set_reviews_text$add_from_data.frame(example_data)
review_labels <- as.factor(example_data$label)
names(review_labels) <- example_data$id
# Create BaseModel
base_model_bert <- BaseModelBert$new()
base_model_bert$create_from_hf(
model_dir = "examples/bert_uncased",
tokenizer_dir = "examples/bert_uncased"
)
# Create TextEmbeddingModel
bert_modeling <- TextEmbeddingModel$new()
bert_modeling$configure(
model_label = "Text Embedding via BERT",
model_language = "english",
max_length = 512,
chunks = 4,
overlap = 30,
emb_layer_min = 6,
emb_layer_max = 8,
emb_pool_type = "Average",
base_model = base_model_bert
)
# Create Embeddings
review_embeddings <- bert_modeling$embed_large(
text_dataset = data_set_reviews_text,
trace = TRUE
)
model_arichtectures <- c(
"TEClassifierSequential"
# "TEClassifierSequentialPrototype"
)
batch_sizes <- c(2, 4, 16, 32, 64)
model_main_config <- list(
label = "Classifier for Estimating a Postive or Negative Rating of Movie Reviews",
text_embeddings = review_embeddings,
feature_extractor = NULL,
target_levels = c("neg", "pos"),
skip_connection_type = "ResidualGate",
cls_pooling_features = 50,
cls_pooling_type = "MinMax",
cls_head_type = "PairwiseOrthogonal",
feat_act_fct = "ELU",
feat_size = 384,
feat_bias = TRUE,
feat_dropout = 0.0,
feat_parametrizations = "None",
feat_normalization_type = "LayerNorm",
ng_conv_act_fct = "ELU",
ng_conv_n_layers = 0,
ng_conv_ks_min = 2,
ng_conv_ks_max = 4,
ng_conv_bias = FALSE,
ng_conv_dropout = 0.1,
ng_conv_parametrizations = "None",
ng_conv_normalization_type = "LayerNorm",
ng_conv_residual_type = "ResidualGate",
dense_act_fct = "ELU",
dense_n_layers = 0,
dense_dropout = 0.5,
dense_bias = FALSE,
dense_parametrizations = "None",
dense_normalization_type = "LayerNorm",
dense_residual_type = "ResidualGate",
rec_act_fct = "Tanh",
rec_n_layers = 0,
rec_type = "GRU",
rec_bidirectional = FALSE,
rec_dropout = 0.2,
rec_bias = FALSE,
rec_parametrizations = "None",
rec_normalization_type = "LayerNorm",
rec_residual_type = "ResidualGate",
tf_act_fct = "ELU",
tf_dense_dim = 400,
tf_n_layers = 2,
tf_dropout_rate_1 = 0.1,
tf_dropout_rate_2 = 0.3,
tf_attention_type = "MultiHead",
tf_positional_type = "absolute",
tf_num_heads = 1,
tf_bias = FALSE,
tf_parametrizations = "None",
tf_normalization_type = "LayerNorm",
tf_normalization_position = "Pre",
tf_residual_type = "ResidualGate"
)
model_configs <- list(
ng = list(
ng_conv_n_layers = 2,
rec_n_layers = 0,
tf_n_layers = 0,
dense_n_layers = 0
),
rec = list(
ng_conv_n_layers = 0,
rec_n_layers = 2,
tf_n_layers = 0,
dense_n_layers = 0
),
dense = list(
ng_conv_n_layers = 0,
rec_n_layers = 0,
tf_n_layers = 0,
dense_n_layers = 2
),
tf = list(
ng_conv_n_layers = 0,
rec_n_layers = 0,
tf_n_layers = 2,
dense_n_layers = 0
)
)
train_config <- list(
data_embeddings = review_embeddings,
data_targets = review_labels,
data_folds = 10,
data_val_size = 0.25,
loss_balance_class_weights = TRUE,
loss_balance_sequence_length = TRUE,
loss_cls_fct_name = "FocalLoss",
use_sc = FALSE,
sc_method = "knnor",
sc_min_k = 1,
sc_max_k = 10,
use_pl = FALSE,
pl_max_steps = 3,
pl_max = 1.00,
pl_anchor = 1.00,
pl_min = 0.00,
sustain_track = TRUE,
sustain_iso_code = "DEU",
sustain_region = NULL,
sustain_interval = 15,
epochs = 1500,
batch_size = 32,
trace = TRUE,
ml_trace = 0,
log_dir = NULL,
log_write_interval = 10,
n_cores = auto_n_cores(),
lr_rate = 1e-3,
lr_warm_up_ratio = 0.02,
optimizer = "AdamW",
Ns = 5,
Nq = 3,
loss_alpha = 0.5,
loss_margin = 0.05
)
for (batch_size in batch_sizes) {
for (model_arichtecture in model_arichtectures) {
for (model_config in names(model_configs)) {
folder_dir <- "Trial/Vignetten_Classifier"
folder_name <- paste0(model_arichtecture, "_", model_config, "_", batch_size)
dir_destination <- file.path(folder_dir, folder_name)
if (dir.exists(dir_destination)) {
message(Sys.Date(), " ", batch_size, " ", model_arichtecture, " ", model_config, "already exists. skip")
} else {
message(Sys.Date(), " ", batch_size, " ", model_arichtecture, " ", model_config)
model <- create_object(model_arichtecture)
config_arguments <- setdiff(names(model_main_config), names(model_configs[[model_config]]))
do.call(
what = model$configure,
args = append(model_configs[[model_config]], model_main_config[config_arguments])
)
train_arguments <- intersect(x = rlang::fn_fmls_names(model$train), y = names(train_config))
train_config$batch_size <- batch_size
do.call(
what = model$train,
args = train_config[train_arguments]
)
save_to_disk(
object = model,
dir_path = folder_dir,
folder_name = folder_name
)
}
}
}
}
