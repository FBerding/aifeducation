linters: linters_with_tags(
  tags=c("common_mistakes","consistency","correctness","efficiency","robustness"),
  object_name_linter=NULL,
  return_linter=return_linter(
    return_style = "explicit",
    allow_implicit_else = TRUE,
    return_functions = NULL,
    except = NULL,
    except_regex = c("shiny","bslib")
    ),
  if_not_else_linter=NULL,
  if_switch_linter=NULL,
  unnecessary_nesting_linter=NULL
  )
exclusions: list("R/RcppExports.R")
